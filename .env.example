# Example settings for docker compose. Copy this file to ".env" and change the values there.
# ".env" is git-ignored, so your own passwords never end up on GitHub.
# These are only development values for a database on your own computer.
POSTGRES_DB=fairshare
POSTGRES_USER=fairshare
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Optional: "Sign in with Google". Leave both empty to switch it off.
# Create an OAuth client in Google Cloud (see the README) and put its values into .env, never into this file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
